---
import Layout from "../layouts/Layout.astro";

const songs = [
  "Essence",
  "Ginger",
  "Come Closer",
  "Ojuelegba",
  "No Stress",
  "True Love",
  "Energy",
  "Mood",
  "Daddy Yo",
];
---

<Layout title="Wizkid Playlist">
  <main class="playlist-container">
    <h1>Wizkid Playlist</h1>

    <ul>
      {songs.map((song) => (
        <li>{song}</li>
      ))}
    </ul>
  </main>
</Layout>
