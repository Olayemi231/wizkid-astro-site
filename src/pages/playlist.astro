---
title: "Playlist"
---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const songs = [
  "Essence",
  "Ginger",
  "Come Closer",
  "Ojuelegba",
  "No Stress",
  "True Love",
  "Energy",
  "Mood",
  "Daddy Yo"
];
---
<Layout title="Wizkid Playlist">
  <Header />

  <main class="playlist-container">
    <h1>Wizkid Playlist</h1>

    <ul>
      {songs.map(song => (
        <li>{song}</li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>
