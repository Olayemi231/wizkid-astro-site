---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Wizkid Fan Hub">

  <main class="home-container">
    <h1>Wizkid</h1>
    <h2>Welcome to the ultimate Wizkid fan experience—music, stories, and more.</h2>

    <a href="/news" class="explore-link">Explore News & Tour</a>

    <div class="home-card">
      <img src="/images/wizkid-hero.jpg" class="home-img" alt="Wizkid" />
      <p>
        Dive into Wizkid’s global journey—breaking boundaries, dominating charts,
        and redefining Afrobeats.
      </p>
    </div>
  </main>
</Layout>
