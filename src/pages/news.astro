---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
---

<Layout title="News & Tour Updates">
  <main>
    <h1>News & Tour Updates</h1>
    <h2>Latest moments, achievements, and Starboy headlines.</h2>

    <div class="news-grid">
      {posts.map((post) => (
        <a href={`/posts/${post.slug}`} class="news-card">
          <img src={post.data.image} class="news-img" />
          <h3>{post.data.title}</h3>
          <p>{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
